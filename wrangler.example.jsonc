{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Copy this file to wrangler.jsonc. Replace resource IDs before deploying.
  "name": "sports-schedule",
  "compatibility_date": "2026-09-10",
  "main": "./src/worker/index.ts",
  "triggers": {
    // Refresh event caches daily at midnight UTC.
    "crons": ["0 0 * * *"],
  },
  "assets": {
    // The Cloudflare Vite plugin supplies the built asset directory.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/signup"],
  },
  // Values belong in .dev.vars locally and .env.production for pnpm run deploy.
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "SPORTSDB_API_KEY",
      "TURNSTILE_SECRET_KEY",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sports-schedule-db",
      // Replace with the ID returned by wrangler d1 create.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SPORTS_CACHE",
      // Replace with the ID returned by wrangler kv namespace create SPORTS_CACHE.
      "id": "00000000000000000000000000000001",
    },
    {
      "binding": "FEATURE_FLAGS",
      // Replace with the ID returned by wrangler kv namespace create FEATURE_FLAGS.
      "id": "00000000000000000000000000000002",
    },
  ],
  // Use distinct numeric namespace IDs that are unique within your account.
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 60,
      },
    },
    {
      "name": "GENERAL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "SIGN_IN_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
    {
      "name": "SIGN_UP_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 3,
        "period": 60,
      },
    },
    {
      "name": "SPORTS_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
}
