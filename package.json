{
  "name": "sports-schedule",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/client/*"
  },
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy --secrets-file .env.production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "pnpm dlx auth@latest generate --adapter drizzle --dialect sqlite --config ./src/worker/auth/auth.ts --output ./src/worker/db/auth-schema.ts -y",
    "lint": "oxlint",
    "test": "pnpm run test:node && pnpm run test:app",
    "test:node": "node --test src/client/components/dashboard/event-utils.test.ts src/worker/services/sportsdb.test.ts",
    "test:app": "vitest run",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@marsidev/react-turnstile": "^1.6.3",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-hotkeys": "^0.22.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "latest",
    "better-auth": "^1.7.16",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "latest",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint-plugin-perfectionist": "^5.13.0",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
